---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/format";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, heroImage, heroImageAlt } = post.data;
---

<article
  class="group relative flex h-full flex-col card-paper p-3 pop transition duration-200 hover:-translate-y-1"
>
  <span class="tape -top-2.5 left-6 -rotate-6"></span>

  <a href={`/blogs/${post.id}/`} class="block overflow-hidden rounded-md border border-ink/15">
    {
      heroImage ? (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ""}
          class="aspect-[16/9] w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="grid aspect-[16/9] w-full place-items-center bg-paper-deep">
          <span class="font-hand text-2xl text-pencil">no cover yet</span>
        </div>
      )
    }
  </a>

  <div class="flex flex-1 flex-col px-2 pb-2 pt-4">
    <time
      datetime={pubDate.toISOString()}
      class="font-hand text-lg leading-none text-pencil"
    >
      {formatDate(pubDate)}
    </time>
    <h3 class="mt-2 text-lg font-semibold leading-snug">
      <a
        href={`/blogs/${post.id}/`}
        class="transition-colors group-hover:text-accent"
      >
        {title}
      </a>
    </h3>
    <p class="mt-2 line-clamp-3 text-sm text-pencil">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-2 pt-4">
          {tags.map((tag) => (
            <li class="rounded-full border border-dashed border-pencil/50 px-2.5 py-0.5 font-hand text-base leading-tight text-pencil">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
