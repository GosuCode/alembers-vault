---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/format";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, heroImage, heroImageAlt } = post.data;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-surface shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md"
>
  <a href={`/blogs/${post.id}/`} class="block overflow-hidden">
    {
      heroImage ? (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ""}
          class="aspect-[16/9] w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="aspect-[16/9] w-full bg-peach/40" />
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-5">
    <time datetime={pubDate.toISOString()} class="text-xs text-muted">
      {formatDate(pubDate)}
    </time>
    <h3 class="mt-2 font-display text-lg font-semibold leading-snug">
      <a
        href={`/blogs/${post.id}/`}
        class="transition-colors group-hover:text-coral-dark"
      >
        {title}
      </a>
    </h3>
    <p class="mt-2 line-clamp-3 text-sm text-muted">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-2 pt-4">
          {tags.map((tag) => (
            <li class="rounded-full border border-line bg-cream px-2.5 py-0.5 text-xs text-muted">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
