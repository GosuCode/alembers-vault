---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { ordinal } from "../lib/academic";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const {
  title,
  description,
  tags,
  links,
  featured,
  program,
  semester,
  status,
  heroImage,
} = project.data;

const semesterLabel = semester
  ? `${program ? `${program} · ` : ""}${ordinal(semester)} sem`
  : program;
const statusLabel =
  status === "archived"
    ? "not maintained"
    : status === "maintained"
      ? "occasionally maintained"
      : null;
---

<article
  class="group relative flex h-full flex-col card-paper p-6 pop transition duration-200 hover:-translate-y-1"
>
  <span class="tape -top-2.5 right-8 rotate-6"></span>

  {
    heroImage && (
      <a
        href={`/projects/${project.id}/`}
        class="mb-4 block overflow-hidden rounded-lg border border-ink/60 bg-white"
      >
        <Image
          src={heroImage}
          alt={`${title} screenshot`}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
          class="h-40 w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      </a>
    )
  }

  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold leading-snug">
      <a
        href={`/projects/${project.id}/`}
        class="transition-colors group-hover:text-accent"
      >
        {title}
      </a>
    </h3>
    {
      featured && (
        <span class="shrink-0 -rotate-3 rounded-full border border-ink/70 bg-marker px-2.5 py-0.5 font-hand text-base leading-tight">
          featured
        </span>
      )
    }
  </div>

  {
    (semesterLabel || statusLabel) && (
      <p class="mt-1 flex flex-wrap items-center gap-x-2 font-hand text-lg leading-none text-pencil">
        {semesterLabel && <span>{semesterLabel}</span>}
        {semesterLabel && statusLabel && <span aria-hidden="true">·</span>}
        {statusLabel && <span>{statusLabel}</span>}
      </p>
    )
  }

  <p class="mt-3 line-clamp-4 text-sm text-pencil">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-full border border-dashed border-pencil/50 px-2.5 py-0.5 font-hand text-base leading-tight text-pencil">
            {tag}
          </li>
        ))}
      </ul>
    )
  }

  {
    links.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-5">
        {links.slice(0, 3).map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border border-ink/70 bg-white px-3 py-1 font-hand text-lg leading-tight transition hover:bg-marker"
          >
            {label} ↗
          </a>
        ))}
      </div>
    )
  }
</article>
