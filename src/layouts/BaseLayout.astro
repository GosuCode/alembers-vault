---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alember's Vault",
  description = "A personal archive of tech blogs, academic materials, and software projects.",
} = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/blogs/", label: "Blogs" },
  { href: "/projects/", label: "Projects" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-950 text-slate-100 antialiased">
    <header class="border-b border-slate-800">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
        <a href="/" class="font-semibold tracking-tight text-amber-400">
          Alember's Vault
        </a>
        <ul class="flex items-center gap-6 text-sm">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    "transition-colors hover:text-white",
                    isActive(href) ? "text-white" : "text-slate-400",
                  ]}
                  aria-current={isActive(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer class="border-t border-slate-800">
      <div
        class="mx-auto max-w-3xl px-6 py-8 text-sm text-slate-500"
      >
        Alember's Vault · Built with Astro
      </div>
    </footer>
  </body>
</html>
