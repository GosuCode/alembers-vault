---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alember's Vault",
  description = "A personal archive of tech blogs, academic materials, and software projects.",
} = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/blogs/", label: "Blogs" },
  { href: "/academic/", label: "Academic" },
  { href: "/projects/", label: "Projects" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header
      class="sticky top-0 z-50 border-b border-line/70 bg-cream/80 backdrop-blur-md"
    >
      <nav
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3.5"
      >
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="grid h-9 w-9 place-items-center rounded-2xl bg-coral text-white shadow-sm"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
          </span>
          <span class="font-display text-lg font-semibold tracking-tight">
            Alember's Vault
          </span>
        </a>

        <ul
          class="hidden items-center gap-1 rounded-full border border-line bg-surface p-1 text-sm shadow-sm sm:flex"
        >
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    "block rounded-full px-3.5 py-1.5 font-medium transition-colors",
                    isActive(href)
                      ? "bg-coral text-white"
                      : "text-muted hover:text-ink",
                  ]}
                  aria-current={isActive(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="flex items-center gap-1 text-sm sm:hidden">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    "block rounded-full px-2.5 py-1.5 font-medium transition-colors",
                    isActive(href)
                      ? "bg-coral text-white"
                      : "text-muted hover:text-ink",
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer class="mt-24 border-t border-line">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} Alember's Vault</p>
        <p>Built with Astro · Supabase</p>
      </div>
    </footer>
  </body>
</html>
