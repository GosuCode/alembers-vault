---
import "../styles/global.css";
import { site } from "../data/site";
import Analytics from "../components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = `${site.name} · Alember's Vault`,
  description = `Notes, papers, and projects by ${site.name}.`,
  jsonLd,
  noindex = false,
} = Astro.props;

const nav = [
  { href: "/", label: "home" },
  { href: "/blogs/", label: "blogs" },
  { href: "/academic/", label: "academic" },
  { href: "/projects/", label: "projects" },
  { href: "/about/", label: "about" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,16..72,400;0,16..72,500;0,16..72,600;1,16..72,400&display=swap"
    />
    <title>{title}</title>
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <header
      class="sticky top-0 z-50 border-b border-dashed border-line bg-paper/90 backdrop-blur"
    >
      <nav
        data-region="nav"
        class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3"
      >
        <a href="/" class="flex items-center gap-3">
          <span
            class="relative grid h-11 w-11 shrink-0 -rotate-3 place-items-center rounded-md border border-ink/80 bg-white pop-sm"
          >
            <span
              class="tape -top-3 left-1/2 h-5 w-14 -translate-x-1/2 -rotate-6"
            ></span>
            <span class="font-hand text-xl font-bold">{site.initials}</span>
          </span>
          <span class="leading-tight">
            <span class="block text-base font-semibold">{site.name}</span>
            <span class="block font-hand text-base text-pencil">
              {site.tagline}
            </span>
          </span>
        </a>

        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 font-hand text-xl">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    "transition-colors hover:text-accent",
                    isActive(href)
                      ? "squiggle text-accent"
                      : "text-ink/80",
                  ]}
                  aria-current={isActive(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer data-region="footer" class="mt-24 border-t border-dashed border-line">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-10 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="font-hand text-3xl text-ink">— {site.shortName}</p>
          <p class="mt-1 text-sm text-pencil">
            © {year} {site.name} · {site.location}
          </p>
        </div>
        <ul class="flex flex-wrap gap-5 font-hand text-xl">
          {
            site.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  class="text-ink/80 transition-colors hover:text-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {social.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <Analytics />
  </body>
</html>
