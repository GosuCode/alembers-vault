---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/format";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  sourceUrl?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  heroImage,
  heroImageAlt = "",
  sourceUrl,
} = Astro.props;
---

<BaseLayout title={`${title} · Blogs`} description={description}>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <a
      href="/blogs/"
      class="font-hand text-xl text-accent transition hover:text-accent-dark"
    >
      ← all blogs
    </a>

    <article class="margin-rule mt-8 pl-6 sm:pl-10">
      <header>
        <p class="font-hand text-xl text-pencil">
          {formatDate(pubDate)}
          {updatedDate && ` · updated ${formatDate(updatedDate)}`}
        </p>
        <h1
          class="mt-2 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
        >
          {title}
        </h1>
        <p class="mt-4 text-lg text-pencil">{description}</p>
        {
          sourceUrl && (
            <p class="mt-3 font-hand text-lg text-pencil">
              originally published on{" "}
              <a
                href={sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent transition hover:text-accent-dark"
              >
                Medium ↗
              </a>
            </p>
          )
        }
        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full border border-dashed border-pencil/50 px-2.5 py-0.5 font-hand text-base leading-tight text-pencil">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        heroImage && (
          <div class="mt-8 -rotate-[0.6deg]">
            <Image
              src={heroImage}
              alt={heroImageAlt}
              class="w-full rounded-lg border border-ink/80 pop-sm"
            />
          </div>
        )
      }

      <div class="prose prose-lg mt-10 max-w-none">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
