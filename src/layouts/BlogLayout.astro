---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/format";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  heroImage,
  heroImageAlt = "",
} = Astro.props;
---

<BaseLayout title={`${title} · Blogs`} description={description}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a
      href="/blogs/"
      class="text-sm text-amber-400 transition-colors hover:text-amber-300"
    >
      ← All blogs
    </a>

    <article class="mt-8">
      <header>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        <p class="mt-3 text-slate-400">{description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {
            updatedDate && (
              <span>
                Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            )
          }
        </div>
        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full border border-slate-700 px-3 py-1 text-xs text-slate-400">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        heroImage && (
          <Image
            src={heroImage}
            alt={heroImageAlt}
            class="mt-8 w-full rounded-xl border border-slate-800"
          />
        )
      }

      <div class="prose prose-invert prose-amber mt-10 max-w-none">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
