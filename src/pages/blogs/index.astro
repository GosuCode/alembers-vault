---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blogs · Alember's Vault"
  description="Notes on building software, tooling, and things learned the hard way."
>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <header class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-coral-dark">
        Writing
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
        Blogs
      </h1>
      <p class="mt-4 text-lg text-muted">
        Notes on building software, tooling, and things learned the hard way.
      </p>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>

    {
      posts.length === 0 && (
        <p class="mt-12 text-muted">No posts yet. Check back soon.</p>
      )
    }
  </main>
</BaseLayout>
