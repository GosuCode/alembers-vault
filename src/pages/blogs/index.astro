---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blogs · Alember's Vault"
  description="Notes on building software, tooling, and things learned the hard way."
>
  <main class="mx-auto max-w-5xl px-6 py-14">
    <header class="max-w-2xl">
      <p class="font-hand text-2xl text-accent">from the notebook</p>
      <h1 class="mt-1 text-4xl font-semibold tracking-tight sm:text-5xl">
        Blogs
      </h1>
      <p class="mt-4 text-lg text-pencil">
        Notes on building software, tooling, and things learned the hard way.
      </p>
    </header>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>

    {
      posts.length === 0 && (
        <p class="mt-12 font-hand text-2xl text-pencil">
          no posts yet — check back soon.
        </p>
      )
    }
  </main>
</BaseLayout>
