---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../lib/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blogs · Alember's Vault"
  description="Notes on building software, tooling, and things learned the hard way."
>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blogs</h1>
    <p class="mt-4 text-slate-400">
      Notes on building software, tooling, and things learned the hard way.
    </p>

    <ul class="mt-12 flex flex-col gap-10">
      {
        posts.map((post) => (
          <li>
            <article>
              {
                post.data.heroImage && (
                  <a href={`/blogs/${post.id}/`} class="block">
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt ?? ""}
                      class="mb-4 aspect-[2/1] w-full rounded-xl border border-slate-800 object-cover"
                    />
                  </a>
                )
              }
              <h2 class="text-xl font-semibold tracking-tight">
                <a
                  href={`/blogs/${post.id}/`}
                  class="transition-colors hover:text-amber-400"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-slate-400">{post.data.description}</p>
              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <ul class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li class="rounded-full border border-slate-800 px-2.5 py-0.5 text-xs">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    {
      posts.length === 0 && (
        <p class="mt-12 text-slate-500">No posts yet. Check back soon.</p>
      )
    }
  </main>
</BaseLayout>
