---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AcademicExplorer from "../../components/AcademicExplorer.tsx";
---

<BaseLayout
  title="Academic · Alember's Vault"
  description="Past papers, project PDFs, and notes with in-browser previews."
>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <header class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-coral-dark">
        Archive
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
        Academic Archive
      </h1>
      <p class="mt-4 text-lg text-muted">
        Past papers, project PDFs, and notes — search, filter, and preview right
        in the browser.
      </p>
    </header>

    <div class="mt-12">
      <AcademicExplorer client:only="react" />
    </div>
  </main>
</BaseLayout>
