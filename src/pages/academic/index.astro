---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AcademicExplorer from "../../components/AcademicExplorer.tsx";
---

<BaseLayout
  title="Academic · Alember's Vault"
  description="Past papers, project PDFs, and notes with in-browser previews."
>
  <main class="mx-auto max-w-5xl px-6 py-14">
    <header class="max-w-2xl">
      <p class="font-hand text-2xl text-accent">the filing cabinet</p>
      <h1 class="mt-1 text-4xl font-semibold tracking-tight sm:text-5xl">
        Academic Archive
      </h1>
      <p class="mt-4 text-lg text-pencil">
        Past papers, project reports, and notes — search, filter, and read them
        right here.
      </p>
    </header>

    <div class="mt-12">
      <AcademicExplorer client:only="react" />
    </div>
  </main>
</BaseLayout>
