---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/format";
import { ordinal } from "../../lib/academic";
import {
  REPORT_NOTICE,
  REPORT_ROLE_LABEL,
  REPORT_ROLE_ORDER,
  STATUS_LABEL,
} from "../../lib/projects";
import { academicFileUrl } from "../../lib/supabase";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const [projects, posts] = await Promise.all([
    getCollection("projects"),
    getCollection("blog", ({ data }) => !data.draft),
  ]);

  // Declared inside getStaticPaths: Astro extracts this function, so it can't
  // reach module-level helpers at build time.
  const normalize = (tag: string) =>
    tag === "postgresql" ? "postgres" : tag === "nextjs" ? "next" : tag;

  return projects.map((project) => {
    const { program, semester, tags } = project.data;

    const moreProjects = projects
      .filter((candidate) => candidate.id !== project.id)
      .sort((a, b) => {
        const sameProgram = (entry: CollectionEntry<"projects">) =>
          program && entry.data.program === program ? 0 : 1;
        const semesterDistance = (entry: CollectionEntry<"projects">) =>
          semester && entry.data.semester
            ? Math.abs(entry.data.semester - semester)
            : 99;
        return (
          sameProgram(a) - sameProgram(b) ||
          semesterDistance(a) - semesterDistance(b) ||
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
        );
      })
      .slice(0, 3);

    const projectTags = new Set(tags.map(normalize));
    const matchCount = (post: CollectionEntry<"blog">) =>
      post.data.tags.filter((tag) => projectTags.has(normalize(tag))).length;

    const relatedPosts = posts
      .sort(
        (a, b) =>
          matchCount(b) - matchCount(a) ||
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      )
      .slice(0, 3);

    return {
      params: { slug: project.id },
      props: { project, moreProjects, relatedPosts },
    };
  });
}

interface Props {
  project: CollectionEntry<"projects">;
  moreProjects: CollectionEntry<"projects">[];
  relatedPosts: CollectionEntry<"blog">[];
}

const { project, moreProjects, relatedPosts } = Astro.props;
const { Content } = await render(project);
const {
  title,
  description,
  pubDate,
  tags,
  links,
  reports,
  program,
  semester,
  year,
  yearBs,
  status,
  tech,
  heroImage,
  gallery,
  notice,
} = project.data;

const semesterLabel = semester ? `${ordinal(semester)} semester` : null;
const programLabel = program ? `${program}${semesterLabel ? ` · ${semesterLabel}` : ""}` : semesterLabel;

const seoTitle =
  program && semester
    ? `${title} · ${program} ${ordinal(semester)} Semester ${tags.includes("internship") ? "Internship" : "Project"}`
    : `${title} · ${program ? `${program} ` : ""}Projects`;
const yearLabel = year
  ? `${yearBs ? `${yearBs} BS · ` : ""}${year} AD`
  : null;
const statusLabel = status ? STATUS_LABEL[status] : null;

const reportsByRole = REPORT_ROLE_ORDER.map((role) => ({
  role,
  items: reports.filter((report) => report.role === role),
})).filter((group) => group.items.length > 0);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const repoLink = links.find((link) => link.kind === "repo")?.href;
const demoLink = links.find(
  (link) => link.kind === "demo" || link.kind === "dashboard",
)?.href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: title,
    description,
    applicationCategory: "WebApplication",
    operatingSystem: "Web",
    url: canonical,
    author: { "@type": "Person", name: site.name },
    inLanguage: "en",
    ...(repoLink ? { codeRepository: repoLink } : {}),
    ...(demoLink ? { installUrl: demoLink } : {}),
    ...(year ? { datePublished: String(year) } : {}),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Projects",
        item: new URL("/projects/", Astro.site).href,
      },
      { "@type": "ListItem", position: 3, name: title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={seoTitle}
  description={description}
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <a
      href="/projects/"
      class="font-hand text-xl text-accent transition hover:text-accent-dark"
    >
      ← all projects
    </a>

    <article class="margin-rule mt-8 pl-6 sm:pl-10">
      <header>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <p class="font-hand text-xl text-pencil">{formatDate(pubDate)}</p>
          {
            (programLabel || yearLabel) && (
              <p class="font-hand text-xl text-pencil">
                {programLabel}
                {programLabel && yearLabel && " · "}
                {yearLabel}
              </p>
            )
          }
        </div>
        <h1
          class="mt-2 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
        >
          {title}
        </h1>
        <p class="mt-4 text-lg text-pencil">{description}</p>

        {
          tech.length > 0 && (
            <p class="mt-3 text-sm text-pencil">
              <span class="font-hand text-lg">built with </span>
              {tech.join(" · ")}
            </p>
          )
        }

        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full border border-dashed border-pencil/50 px-2.5 py-0.5 font-hand text-base leading-tight text-pencil">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }

        {
          links.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-3">
              {links.map(({ href, label }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-md border border-ink/80 bg-marker px-4 py-1.5 font-hand text-xl leading-tight pop-sm transition hover:-translate-y-0.5"
                >
                  {label} ↗
                </a>
              ))}
            </div>
          )
        }
      </header>

      {
        heroImage && (
          <Image
            src={heroImage}
            alt={`${title} screenshot`}
            widths={[600, 1200]}
            sizes="(min-width: 768px) 768px, 90vw"
            class="mt-8 w-full rounded-lg border border-ink/60"
          />
        )
      }

      <div class="mt-8 rounded-lg border border-ink/60 bg-marker/60 p-4 text-sm">
        <p class="font-hand text-xl">⚠ final report, not updated</p>
        <p class="mt-1 text-pencil">{notice ?? REPORT_NOTICE}</p>
        {statusLabel && <p class="mt-2 text-pencil">Status: {statusLabel}.</p>}
      </div>

      <div class="prose prose-lg mt-10 max-w-none">
        <Content />
      </div>

      {
        reportsByRole.length > 0 && (
          <section class="mt-12 border-t border-dashed border-line pt-8">
            <h2 class="font-hand text-3xl sketch-underline">
              Report &amp; documents
            </h2>
            {reportsByRole.map(({ role, items }) => (
              <div class="mt-5">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-pencil">
                  {REPORT_ROLE_LABEL[role]}
                </h3>
                <ul class="mt-3 grid gap-3">
                  {items.map((item) => (
                    <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-ink/60 bg-white px-4 py-3">
                      <div>
                        <p class="text-sm font-semibold">{item.label}</p>
                        {item.note && (
                          <p class="text-sm text-pencil">{item.note}</p>
                        )}
                      </div>
                      <div class="flex gap-2">
                        {item.kind === "pdf" && (
                          <a
                            href={academicFileUrl(item.path)}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="rounded-md border border-ink/70 bg-accent px-3 py-1 font-hand text-lg leading-tight text-white transition hover:bg-accent-dark"
                          >
                            open ↗
                          </a>
                        )}
                        <a
                          href={academicFileUrl(item.path)}
                          download
                          class="rounded-md border border-ink/70 bg-marker px-3 py-1 font-hand text-lg leading-tight transition hover:-translate-y-0.5"
                        >
                          download
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )
      }

      {
        gallery.length > 0 && (
          <section class="mt-12 border-t border-dashed border-line pt-8">
            <h2 class="font-hand text-3xl sketch-underline">Screens &amp; diagrams</h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              {gallery.map((item) => (
                <figure>
                  <a
                    href={item.src.src}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block overflow-hidden rounded-lg border border-ink/60 bg-white transition hover:-translate-y-0.5"
                  >
                    <Image
                      src={item.src}
                      alt={item.caption}
                      widths={[400, 800]}
                      sizes="(min-width: 640px) 45vw, 90vw"
                      class="w-full"
                    />
                  </a>
                  <figcaption class="mt-2 font-hand text-lg text-pencil">
                    {item.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        moreProjects.length > 0 && (
          <section class="mt-12 border-t border-dashed border-line pt-8">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <h2 class="font-hand text-3xl sketch-underline">more projects</h2>
              <a
                href="/projects/"
                class="font-hand text-xl text-accent transition hover:text-accent-dark"
              >
                all projects →
              </a>
            </div>
            <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {moreProjects.map((item) => (
                <li class="flex">
                  <a
                    href={`/projects/${item.id}/`}
                    class="group relative flex h-full w-full flex-col card-paper pop transition duration-200 hover:-translate-y-1 hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
                  >
                    <span class="tape -top-2.5 left-6 -rotate-6"></span>
                    <span class="block overflow-hidden rounded-t-lg border-b border-ink/10">
                      {item.data.heroImage ? (
                        <Image
                          src={item.data.heroImage}
                          alt={`${item.data.title} screenshot`}
                          widths={[300, 600]}
                          sizes="(min-width: 1024px) 16rem, (min-width: 640px) 45vw, 90vw"
                          class="aspect-[16/9] w-full object-cover"
                        />
                      ) : (
                        <span class="grid aspect-[16/9] w-full place-items-center bg-paper-deep font-hand text-lg text-pencil">
                          no cover yet
                        </span>
                      )}
                    </span>
                    <span class="flex flex-1 flex-col px-4 pb-4 pt-3">
                      <span class="font-hand text-base leading-tight text-pencil">
                        {item.data.program && item.data.semester
                          ? `${item.data.program} · ${ordinal(item.data.semester)} semester`
                          : "Project"}
                      </span>
                      <span class="mt-0.5 font-semibold leading-snug transition-colors group-hover:text-accent">
                        {item.data.title}
                      </span>
                      <span class="mt-1 line-clamp-4 text-sm text-pencil">
                        {item.data.description}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        relatedPosts.length > 0 && (
          <section class="mt-12 border-t border-dashed border-line pt-8">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <h2 class="font-hand text-3xl sketch-underline">from the blog</h2>
              <a
                href="/blogs/"
                class="font-hand text-xl text-accent transition hover:text-accent-dark"
              >
                all blogs →
              </a>
            </div>
            <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {relatedPosts.map((post) => (
                <li class="flex">
                  <a
                    href={`/blogs/${post.id}/`}
                    class="group relative flex h-full w-full flex-col card-paper pop transition duration-200 hover:-translate-y-1 hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
                  >
                    <span class="tape -top-2.5 left-6 -rotate-6"></span>
                    <span class="block overflow-hidden rounded-t-lg border-b border-ink/10">
                      {post.data.heroImage ? (
                        <Image
                          src={post.data.heroImage}
                          alt={post.data.heroImageAlt ?? ""}
                          widths={[300, 600]}
                          sizes="(min-width: 1024px) 16rem, (min-width: 640px) 45vw, 90vw"
                          class="aspect-[16/9] w-full object-cover"
                        />
                      ) : (
                        <span class="grid aspect-[16/9] w-full place-items-center bg-paper-deep font-hand text-lg text-pencil">
                          no cover yet
                        </span>
                      )}
                    </span>
                    <span class="flex flex-1 flex-col px-4 pb-4 pt-3">
                      <span class="font-hand text-base leading-tight text-pencil">
                        {formatDate(post.data.pubDate)}
                      </span>
                      <span class="mt-0.5 font-semibold leading-snug transition-colors group-hover:text-accent">
                        {post.data.title}
                      </span>
                      <span class="mt-1 line-clamp-4 text-sm text-pencil">
                        {post.data.description}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>
</BaseLayout>
