---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { ordinal } from "../../lib/academic";

const all = await getCollection("projects");
const byDate = (
  a: (typeof all)[number],
  b: (typeof all)[number],
): number => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const semesterProjects = all
  .filter((project) => project.data.program && project.data.semester)
  .sort((a, b) => (a.data.semester ?? 0) - (b.data.semester ?? 0));
const personalProjects = all
  .filter((project) => !(project.data.program && project.data.semester))
  .sort(byDate);

const description =
  "BCA semester projects and personal projects — write-ups, reports, repositories, and live demos.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "BCA Semester Projects",
    description,
    url: new URL("/projects/", Astro.site).href,
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: all.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.data.title,
      url: new URL(`/projects/${project.id}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="BCA Semester Projects & Personal Projects · Alember's Vault"
  description={description}
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-5xl px-6 py-14">
    <header class="max-w-2xl">
      <p class="font-hand text-2xl text-accent">built &amp; half-broken</p>
      <h1 class="mt-1 text-4xl font-semibold tracking-tight sm:text-5xl">
        Projects
      </h1>
      <p class="mt-4 text-lg text-pencil">
        BCA semester projects and personal projects, with write-ups, reports,
        repositories, and live demos.
      </p>
    </header>

    <section class="mt-14">
      <h2 class="font-hand text-3xl sketch-underline">BCA semester projects</h2>
      <p class="mt-4 max-w-3xl text-pencil">
        Final reports and write-ups from my <strong>Bachelor in Computer
        Applications (BCA)</strong> under Tribhuvan University — the 4th, 6th,
        7th (internship), and 8th semester work. Each entry links to the full
        report, proposal, presentation, and the course guideline it was built
        against.
      </p>

      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          semesterProjects.map((project) => (
            <li class="flex">
              <a
                href={`/projects/${project.id}/`}
                class="group flex h-full w-full flex-col card-paper p-6 pop transition duration-200 hover:-translate-y-1 hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
              >
                <p class="font-hand text-xl text-accent">
                  BCA {ordinal(project.data.semester ?? 0)} semester{" "}
                  {project.data.tags.includes("internship")
                    ? "internship"
                    : "project"}
                </p>
                <h3 class="mt-1 text-lg font-semibold leading-snug transition-colors group-hover:text-accent">
                  {project.data.title}
                </h3>
                <p class="mt-2 text-sm text-pencil">{project.data.description}</p>
                <span class="mt-auto inline-flex items-center gap-1 pt-4 font-hand text-lg text-accent transition group-hover:translate-x-0.5 group-hover:text-accent-dark">
                  write-up &amp; report →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      personalProjects.length > 0 && (
        <section class="mt-16 border-t border-dashed border-line pt-10">
          <h2 class="font-hand text-3xl sketch-underline">Personal projects</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {personalProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }

    {
      all.length === 0 && (
        <p class="mt-12 font-hand text-2xl text-pencil">
          no projects yet — check back soon.
        </p>
      )
    }
  </main>
</BaseLayout>
