---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const sections = [
  {
    href: "/academic/",
    title: "Academic archive",
    body: "Tribhuvan University BCA past papers with searchable text, plus project reports and course guidelines.",
  },
  {
    href: "/projects/",
    title: "Projects",
    body: "Semester projects, the internship, and personal builds — with reports, diagrams and live links.",
  },
  {
    href: "/blogs/",
    title: "Blogs",
    body: "Notes on Node.js, Docker, Redis, CORS, deployment and everything else I bump into.",
  },
];
---

<BaseLayout
  title={`About · ${site.name}`}
  description={`About ${site.name} — ${site.role.toLowerCase()}, and the archive they built.`}
>
  <main class="mx-auto max-w-3xl px-6 py-14">
    <header class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-start">
      <div class="max-w-xl">
        <p class="font-hand text-2xl text-accent">about</p>
        <h1 class="mt-1 text-4xl font-semibold tracking-tight sm:text-5xl">
          {site.name}
        </h1>
        <p class="mt-4 text-lg text-pencil">
          {site.role} · {site.location}
        </p>
      </div>

      <div
        class="relative -rotate-2 rounded-lg border border-ink/80 bg-white p-3 pop-sm"
      >
        <span class="tape -top-3 left-1/2 -translate-x-1/2 -rotate-3"></span>
        {
          site.avatar ? (
            <img
              src={site.avatar}
              alt={site.name}
              class="h-32 w-32 rounded-md object-cover"
            />
          ) : (
            <div
              class="grid h-32 w-32 place-items-center rounded-md bg-paper-deep"
            >
              <span class="font-hand text-5xl font-bold">{site.initials}</span>
            </div>
          )
        }
        <p class="mt-2 text-center font-hand text-lg text-pencil">
          @{site.handle}
        </p>
      </div>
    </header>

    <div class="margin-rule mt-10 pl-6 sm:pl-10">
      <div class="prose prose-lg max-w-none">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <section class="mt-12">
        <h2 class="font-hand text-3xl sketch-underline">what I work with</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {
            site.skills.map((group) => (
              <div class="card-paper p-4 pop-sm">
                <p class="font-hand text-xl text-accent">{group.label}</p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <li class="rounded-full border border-dashed border-pencil/50 px-2.5 py-0.5 font-hand text-base leading-tight text-pencil">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-12">
        <h2 class="font-hand text-3xl sketch-underline">right now</h2>
        <ul class="mt-5 space-y-2">
          {
            site.now.map((item) => (
              <li class="flex gap-3">
                <span class="text-accent">·</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12">
        <h2 class="font-hand text-3xl sketch-underline">on this site</h2>
        <ul class="mt-5 grid gap-3">
          {
            sections.map((section) => (
              <li>
                <a
                  href={section.href}
                  class="group block rounded-lg border border-ink/60 bg-white px-4 py-3 transition hover:-translate-y-0.5 hover:border-accent"
                >
                  <span class="font-semibold transition-colors group-hover:text-accent">
                    {section.title}
                  </span>
                  <span class="mt-1 block text-sm text-pencil">
                    {section.body}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12">
        <h2 class="font-hand text-3xl sketch-underline">find me</h2>
        <ul class="mt-5 flex flex-wrap gap-3">
          {
            site.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block rounded-md border border-ink/80 bg-white px-4 py-1.5 font-hand text-xl leading-tight pop-sm transition hover:-translate-y-0.5 hover:bg-marker"
                >
                  {social.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
