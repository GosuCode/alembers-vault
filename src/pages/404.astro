---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Alember's Vault"
  description="The page you were looking for does not exist."
>
  <main
    class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-6 py-24"
  >
    <p class="font-hand text-6xl text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
      This page slipped out of the notebook.
    </h1>
    <p class="mt-4 text-lg text-pencil">
      Whatever you were looking for isn't filed here — it may have been moved or
      renamed.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a
        href="/"
        class="rounded-md border border-ink/80 bg-accent px-5 py-2.5 font-semibold text-white pop-sm transition hover:-translate-y-0.5 hover:bg-accent-dark"
      >
        back home
      </a>
      <a
        href="/blogs/"
        class="rounded-md border border-ink/80 bg-white px-5 py-2.5 font-semibold pop-sm transition hover:-translate-y-0.5"
      >
        read the blogs
      </a>
    </div>
  </main>
</BaseLayout>
