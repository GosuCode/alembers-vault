---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Alember's Vault"
  description="The page you were looking for does not exist."
>
  <main
    class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-6 py-24"
  >
    <p class="font-display text-6xl font-semibold text-peach">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
      Nothing in the vault here.
    </h1>
    <p class="mt-4 text-lg text-muted">
      The page you were looking for does not exist or has moved.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a
        href="/"
        class="rounded-full bg-coral px-5 py-2.5 font-semibold text-white shadow-sm transition hover:bg-coral-dark"
      >
        Go home
      </a>
      <a
        href="/blogs/"
        class="rounded-full border border-line bg-surface px-5 py-2.5 font-semibold transition hover:border-coral hover:text-coral-dark"
      >
        Read the blogs
      </a>
    </div>
  </main>
</BaseLayout>
