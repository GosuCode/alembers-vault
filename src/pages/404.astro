---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Alember's Vault"
  description="The page you were looking for does not exist."
>
  <main
    class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-6 py-24"
  >
    <p class="text-sm font-medium uppercase tracking-widest text-amber-400">
      404
    </p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
      Nothing in the vault here.
    </h1>
    <p class="mt-4 text-slate-400">
      The page you were looking for does not exist or has moved.
    </p>
    <div class="mt-8 flex flex-wrap gap-4 text-sm">
      <a
        href="/"
        class="rounded-lg border border-amber-400 px-4 py-2 text-amber-400 transition-colors hover:bg-amber-400 hover:text-slate-950"
      >
        Go home
      </a>
      <a
        href="/blogs/"
        class="rounded-lg border border-slate-700 px-4 py-2 text-slate-300 transition-colors hover:border-slate-500"
      >
        Read the blogs
      </a>
    </div>
  </main>
</BaseLayout>
