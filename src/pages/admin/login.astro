---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoginForm from "../../components/admin/LoginForm.tsx";
---

<BaseLayout
  title="Sign in · Alember's Vault"
  description="Private dashboard sign-in."
  noindex
>
  <main class="mx-auto flex min-h-[60vh] max-w-md flex-col justify-center px-6 py-16">
    <h1 class="font-hand text-4xl text-ink">sign in</h1>
    <p class="mb-6 mt-1 text-sm text-pencil">
      Magic-link sign-in for the vault dashboard.
    </p>
    <LoginForm client:load />
    <a
      href="/"
      class="mt-8 font-hand text-xl text-accent transition hover:text-accent-dark"
    >
      ← back to the vault
    </a>
  </main>
</BaseLayout>
