---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-24">
    <p class="text-sm font-medium uppercase tracking-widest text-amber-400">
      Alember's Vault
    </p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
      Tech blogs, academic papers, and project showcases.
    </h1>
    <p class="mt-6 text-lg text-slate-400">
      A personal full-stack archive. Blogs, past papers, project PDFs, and
      GitHub-backed showcases — all in one place.
    </p>
  </main>
</BaseLayout>
