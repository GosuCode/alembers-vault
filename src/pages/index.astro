---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { site } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPosts = posts.slice(0, 3);
const featuredProjects = projects.slice(0, 2);

const topics = new Set(posts.flatMap((post) => post.data.tags));

const stats = [
  { label: "blog posts", value: String(posts.length) },
  { label: "projects", value: String(projects.length) },
  { label: "topics", value: String(topics.size) },
];
---

<BaseLayout>
  <main class="mx-auto max-w-5xl px-6">
    <section class="grid gap-10 pt-14 pb-10 lg:grid-cols-[1.5fr_1fr] lg:items-start">
      <div>
        <p class="font-hand text-2xl text-accent">hello —</p>
        <h1
          class="mt-2 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl"
        >
          I'm {site.shortName}. I keep <span class="marker">notes</span> on the
          things I build and study.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-pencil">
          {site.bio[0]}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/blogs/"
            class="rounded-md border border-ink/80 bg-accent px-5 py-2.5 text-sm font-semibold text-white pop-sm transition hover:-translate-y-0.5 hover:bg-accent-dark"
          >
            read the blogs
          </a>
          <a
            href="/academic/"
            class="rounded-md border border-ink/80 bg-white px-5 py-2.5 text-sm font-semibold pop-sm transition hover:-translate-y-0.5"
          >
            browse the archive
          </a>
        </div>
      </div>

      <aside
        class="relative mt-4 rotate-1 rounded-lg border border-ink/80 bg-white p-6 pop lg:mt-2"
      >
        <span class="tape -top-3 left-8 -rotate-6"></span>
        <p class="font-hand text-2xl">currently</p>
        <ul class="mt-3 space-y-1.5 text-sm text-ink/90">
          {
            site.now.map((item) => (
              <li class="flex gap-2">
                <span class="text-accent">·</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <svg
          viewBox="0 0 80 40"
          class="mt-4 h-8 w-20 text-accent"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 30 C 22 6, 44 4, 70 12"></path>
          <path d="M62 6 l9 6 -9 6"></path>
        </svg>
      </aside>
    </section>

    <dl class="grid gap-4 sm:grid-cols-3">
      {
        stats.map((stat, index) => (
          <div
            class:list={[
              "relative card-paper p-5 pop-sm",
              index % 2 === 0 ? "-rotate-1" : "rotate-1",
            ]}
          >
            <span class="tape -top-2.5 left-1/2 -translate-x-1/2 -rotate-2"></span>
            <dt class="font-hand text-lg text-pencil">{stat.label}</dt>
            <dd class="mt-1 text-3xl font-semibold">{stat.value}</dd>
          </div>
        ))
      }
    </dl>

    <section class="mt-20">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="font-hand text-3xl sketch-underline">fresh notes</h2>
        <a
          href="/blogs/"
          class="font-hand text-xl text-accent transition hover:text-accent-dark"
        >
          all blogs →
        </a>
      </div>

      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => <BlogCard post={post} />)}
      </div>
    </section>

    <section class="mt-20">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="font-hand text-3xl sketch-underline">things I built</h2>
        <a
          href="/projects/"
          class="font-hand text-xl text-accent transition hover:text-accent-dark"
        >
          all projects →
        </a>
      </div>

      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
</BaseLayout>
