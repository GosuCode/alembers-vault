#!/usr/bin/env bash
# Pre-commit secret guard for alembers-vault.
#
# 1. Refuses to commit local secret files (.env, .env.local, .dev.vars, ...).
# 2. Runs gitleaks on the staged diff when installed.
# 3. Falls back to a dependency-free scan when gitleaks is missing.
#
# Bypass once with: git commit --no-verify
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged" ]; then
  exit 0
fi

# ── 1. local secret files ────────────────────────────────────────────────────
secret_files=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env(\..*)?$|(^|/)\.dev\.vars$' | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$secret_files" ]; then
  echo "✖ refusing to commit local secret file(s):" >&2
  printf '  %s\n' $secret_files >&2
  echo "  These must stay untracked. Remove with: git restore --staged <file>" >&2
  exit 1
fi

# ── 2. gitleaks (preferred) ──────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner; then
    echo "✖ gitleaks found a secret in the staged changes — commit blocked." >&2
    exit 1
  fi
  exit 0
fi

# ── 3. fallback scan ─────────────────────────────────────────────────────────
echo "⚠ gitleaks not installed — running the built-in fallback scan." >&2
echo "  install it: https://github.com/gitleaks/gitleaks#installing" >&2

patterns=(
  'sb_secret_[A-Za-z0-9_-]{16,}'
  'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '(AKIA|ASIA)[0-9A-Z]{16}'
  'ghp_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'SUPABASE_SERVICE_ROLE_KEY[[:space:]]*=[[:space:]]*[^[:space:]]'
  'INGEST_TOKEN[[:space:]]*=[[:space:]]*[A-Za-z0-9]{16,}'
  'IP_SALT[[:space:]]*=[[:space:]]*[^[:space:]]'
)

found=0
while IFS= read -r file; do
  case "$file" in
    .githooks/*|.gitleaks.toml) continue ;;
  esac
  for pattern in "${patterns[@]}"; do
    # grep -I skips binaries; -n prints line numbers.
    matches=$(git show ":$file" 2>/dev/null | grep -InE -e "$pattern" || true)
    if [ -n "$matches" ]; then
      echo "✖ possible secret in $file:" >&2
      printf '  %s\n' "$matches" >&2
      found=1
    fi
  done
done <<< "$staged"

if [ "$found" -ne 0 ]; then
  echo "  commit blocked. If this is a false positive, use: git commit --no-verify" >&2
  exit 1
fi

exit 0
