# Supabase (public — safe for client bundles)
# Settings → API Keys → publishable key (sb_publishable_...)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never expose to the client, never commit)
# Settings → API Keys → Create new secret key (sb_secret_...).
# Bypasses RLS; used by scripts/upload-academic.mjs.
SUPABASE_SERVICE_ROLE_KEY=
