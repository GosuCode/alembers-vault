# Supabase (public — safe for client bundles)
# Settings → API Keys → publishable key (sb_publishable_...)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never expose to the client, never commit)
# Settings → API Keys → Create new secret key (sb_secret_...).
# Bypasses RLS; used by scripts/upload-academic.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Worker secrets (NOT .env — set with `wrangler secret put`):
#   SUPABASE_URL       — same as PUBLIC_SUPABASE_URL
#   SUPABASE_ANON_KEY  — same as PUBLIC_SUPABASE_ANON_KEY
#   INGEST_TOKEN       — random token; its sha256 lives in analytics.ingest_config
#   IP_SALT            — random string used to hash visitor IPs
# For local `pnpm dev:api`, put the four values in .dev.vars (gitignored).
#
# Generate the ingest token + hash:
#   openssl rand -hex 32                      # -> INGEST_TOKEN
#   printf '%s' "$TOKEN" | sha256sum          # -> analytics.ingest_config.token_hash

